---
BasedOnStyle: Google
Language: Cpp
Standard: c++17
# Google's limit is 80; this codebase has long Eigen types and descriptive
# parameter names, so 100 keeps signatures on one line without sprawling.
ColumnLimit: 100
# Keep the trailing "// Data matrix"-style argument comments aligned.
ReflowComments: false
SortIncludes: CaseSensitive
# numerical_optimizer/alignment.h declares std::vector specializations for Eigen
# types (PoseLib's EIGEN_DEFINE_STL_VECTOR_SPECIALIZATION_CUSTOM). They must be
# visible before anything instantiates std::vector<Eigen::Vector2d>, so the
# headers that pull them in sort ahead of the rest.
IncludeCategories:
  - Regex: 'numerical_optimizer/(alignment|camera_pose|types)\.h'
    Priority: 1
  - Regex: '^<Eigen/'
    Priority: 2
  - Regex: '^<'
    Priority: 3
  - Regex: '.*'
    Priority: 4
